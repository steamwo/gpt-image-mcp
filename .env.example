OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_IMAGE_MODEL=gpt-image-2.6-sunburst
GPT_IMAGE_OUTPUT_DIR=./generated-images
GPT_IMAGE_TIMEOUT=10m
GPT_IMAGE_EMBED_MAX_BYTES=8388608

# Optional. When set, reference images must be inside one of these directories.
# Use your OS path-list separator: ':' on macOS/Linux, ';' on Windows.
# GPT_IMAGE_ALLOWED_DIRS=/path/to/uploads:/another/path

# Optional OpenAI headers.
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...
