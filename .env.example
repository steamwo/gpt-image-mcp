# Authentication is optional. Leave empty for local/no-auth OpenAI-compatible endpoints.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_IMAGE_MODEL=gpt-image-2.6-sunburst
GPT_IMAGE_OUTPUT_DIR=./generated-images
GPT_IMAGE_TIMEOUT=10m
GPT_IMAGE_EMBED_MAX_BYTES=8388608

# Provider compatibility profile: auto | openai | compatible | minimal
# auto selects openai for api.openai.com and compatible for other endpoints.
GPT_IMAGE_PROFILE=auto

# Reference image sources.
GPT_IMAGE_ALLOW_REMOTE_IMAGES=true
GPT_IMAGE_ALLOW_PRIVATE_REMOTE_IMAGES=false

# Optional. When set, local reference images must resolve inside one of these directories.
# Symlinks are resolved before the allow-list check.
# Use your OS path-list separator: ':' on macOS/Linux, ';' on Windows.
# GPT_IMAGE_ALLOWED_DIRS=/path/to/uploads:/another/path

# Optional advanced defaults. They are sent only when the active provider profile supports them.
# GPT_IMAGE_DEFAULT_BACKGROUND=auto
# GPT_IMAGE_DEFAULT_OUTPUT_FORMAT=png
# GPT_IMAGE_DEFAULT_COMPLEXITY=high
# GPT_IMAGE_DEFAULT_INPUT_FIDELITY=high
# GPT_IMAGE_DEFAULT_OUTPUT_COMPRESSION=90

# Optional OpenAI headers.
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...

# Optional arbitrary headers for custom gateways/authentication.
# OPENAI_EXTRA_HEADERS_JSON={"X-API-Key":"secret"}
